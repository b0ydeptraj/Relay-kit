/* Relay-kit — Qt stylesheet (generated). Pair with relay_kit_theme.py */
* { font-family: "Inter", "Segoe UI", sans-serif; font-size: 16px; color: #22201C; }
QMainWindow, QWidget { background: #FAF6EF; }
QFrame#Card, QGroupBox { background: #FFFFFF; border: 1px solid #E8DFCF; border-radius: 12px; }
QLabel#H1 { font-family: "Fraunces", Georgia, serif; font-size: 32px; color: #22201C; }
QLabel#Eyebrow { color: #059669; font-weight: 700; letter-spacing: 1px; }
QLabel#Muted { color: #6E665A; }
QPushButton { background: #FFFFFF; border: 1px solid #E8DFCF; border-radius: 8px; padding: 8px 16px; }
QPushButton:hover { border-color: #059669; color: #059669; }
QPushButton#Primary { background: #059669; color: #FFFFFF; border: none; font-weight: 600; }
QPushButton#Primary:hover { background: #047857; }
QLineEdit, QComboBox, QPlainTextEdit { background: #FFFFFF; border: 1px solid #E8DFCF; border-radius: 8px; padding: 8px 10px; selection-background-color: #DBF3EA; }
QLineEdit:focus, QComboBox:focus { border: 1.5px solid #059669; }
QListWidget#Nav { background: #F3ECDF; border: none; border-right: 1px solid #E8DFCF; padding: 8px; }
QListWidget#Nav::item { padding: 9px 12px; border-radius: 8px; color: #4A443B; }
QListWidget#Nav::item:selected { background: #DBF3EA; color: #047857; }
QProgressBar { background: #F3ECDF; border: none; border-radius: 999px; height: 8px; text-align: center; }
QProgressBar::chunk { background: #059669; border-radius: 999px; }
QHeaderView::section { background: #F3ECDF; color: #6E665A; border: none; padding: 8px; }
QStatusBar { background: #F3ECDF; color: #6E665A; }
