{
  "$name": "Relay-kit Design System",
  "$version": "1.0.0",
  "$description": "Single source of truth. Change a value here and re-export to propagate across web, desktop (Qt/ImGui) and mobile (Flutter/React Native).",
  "$accent": "emerald — swap `color.light.primary` + `color.dark.primary` families to re-theme everything",

  "color": {
    "light": {
      "bg":            "#FAF6EF",
      "surface":       "#FFFFFF",
      "surface2":      "#F3ECDF",
      "ink":           "#22201C",
      "inkSoft":       "#4A443B",
      "muted":         "#6E665A",
      "line":          "#E8DFCF",
      "lineSoft":      "#F0E9DB",
      "primary":       "#059669",
      "primaryDeep":   "#047857",
      "primaryTint":   "#DBF3EA",
      "onPrimary":     "#FFFFFF",
      "success":       "#059669",
      "warning":       "#B7791F",
      "danger":        "#C0392B",
      "info":          "#2F6DB0",
      "band":          "#14120D",
      "onBand":        "#F3ECDD"
    },
    "dark": {
      "bg":            "#15140F",
      "surface":       "#201E17",
      "surface2":      "#26231B",
      "ink":           "#F2EBDD",
      "inkSoft":       "#D6CDBB",
      "muted":         "#9C9284",
      "line":          "#332C22",
      "lineSoft":      "#2A241B",
      "primary":       "#34D399",
      "primaryDeep":   "#6EE7B7",
      "primaryTint":   "#0E241C",
      "onPrimary":     "#08130D",
      "success":       "#34D399",
      "warning":       "#E0A94B",
      "danger":        "#E1685A",
      "info":          "#7FA8DA",
      "band":          "#0E0C09",
      "onBand":        "#F3ECDD"
    }
  },

  "font": {
    "family": {
      "display": { "web": "Fraunces", "fallback": "Georgia, 'Times New Roman', serif" },
      "sans":    { "web": "Inter",    "fallback": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" },
      "mono":    { "web": "JetBrains Mono", "fallback": "ui-monospace, SFMono-Regular, Menlo, monospace" }
    },
    "size": {
      "displayXl": 56, "display": 40, "h1": 32, "h2": 24, "h3": 19,
      "bodyLg": 18, "body": 16, "small": 14, "caption": 12.5
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "lineHeight": { "tight": 1.1, "snug": 1.3, "normal": 1.5, "relaxed": 1.65 },
    "letterSpacing": { "display": "-0.02em", "eyebrow": "0.12em", "normal": "0" }
  },

  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64, "9": 96 },
  "radius": { "sm": 8, "md": 12, "lg": 16, "xl": 24, "pill": 999 },
  "border": { "hairline": 1, "regular": 1.5, "accent": 3 },

  "elevation": {
    "e1": "0 1px 2px rgba(40,30,20,.05), 0 6px 16px -10px rgba(60,40,25,.18)",
    "e2": "0 1px 2px rgba(40,30,20,.05), 0 14px 34px -18px rgba(60,40,25,.24)"
  },
  "motion": {
    "fast": "150ms", "base": "240ms", "slow": "360ms",
    "ease": "cubic-bezier(.2,.6,.2,1)"
  }
}
